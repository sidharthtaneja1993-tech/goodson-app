# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Get this from resend.com (Settings > API Keys) after signing up
RESEND_API_KEY=your-resend-api-key

# "Display Name <address>" to send waitlist emails from.
# Use onboarding@resend.dev until you verify goodson.in as a sending
# domain in Resend, then switch to something like hello@goodson.in
RESEND_FROM_EMAIL=Goodson <onboarding@resend.dev>

# Where "new waitlist signup" notification emails should be sent
NOTIFY_EMAIL=you@example.com

# Supabase > Project Settings > API > service_role key. SERVER ONLY - never
# put this in a NEXT_PUBLIC_ variable or share it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
# Razorpay Dashboard > Webhooks (the secret you type when creating the webhook)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# USD (needs international payments enabled) or INR
RAZORPAY_CURRENCY=USD
# Only used when RAZORPAY_CURRENCY=INR
RAZORPAY_INR_PER_USD=88
