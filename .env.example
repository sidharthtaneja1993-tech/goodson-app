# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Get this from resend.com (Settings > API Keys) after signing up
RESEND_API_KEY=your-resend-api-key

# "Display Name <address>" to send waitlist emails from.
# Use onboarding@resend.dev until you verify goodson.in as a sending
# domain in Resend, then switch to something like hello@goodson.in
RESEND_FROM_EMAIL=Goodson <onboarding@resend.dev>

# Where "new waitlist signup" notification emails should be sent
NOTIFY_EMAIL=you@example.com
